{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abode-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "RoomDO" }]
  },
  // SQLite-backed Durable Objects are the only kind available on the Workers
  // Free plan. Room state is in-memory, so no SQL is actually used; this
  // migration exists purely to satisfy the free-tier class requirement.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }]
}
